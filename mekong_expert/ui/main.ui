    <property name="styleSheet">
      <string>
QWidget { font-family: "Segoe UI", "DejaVu Sans"; font-size: 14px; color: #173e35; }
QMainWindow { background: #f4f8f1; }
QLabel#homeTitle { font-size: 36px; font-weight: 700; color: #185c4b; }
QLabel#homeSubtitle { font-size: 18px; }
QLabel#consultTitle { font-size: 24px; font-weight: 700; color: #185c4b; }
QLabel#resultTitle { font-size: 16px; font-weight: 700; }
QFrame#homePanel, QGroupBox { background: rgba(255,255,250,235); border: 1px solid #d1e1d5; border-radius: 12px; }
QGroupBox { margin-top: 10px; padding: 10px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; left: 14px; }
QComboBox { background: white; border: 1px solid #adc9bb; border-radius: 5px; padding: 6px; min-height: 22px; }
QComboBox QAbstractItemView { background: white; color: #173e35; selection-background-color: #d6ecdf; }
QPushButton { background: #24705b; color: white; border: none; border-radius: 6px; padding: 9px 12px; font-weight: 600; }
QPushButton:hover { background: #18513f; }
QPushButton:focus { border: 2px solid #8ac4aa; }
QPushButton#xoa_btt, QPushButton#quaylai_btt, QPushButton#guide_btt { background: #e2efe5; color: #173e35; }
QTextEdit, QListWidget { background: rgba(255,255,255,245); border: 1px solid #bad3c4; border-radius: 6px; padding: 7px; }
QListWidget::item { padding: 8px; }
QListWidget::item:selected { background: #d2eadc; color: #123f31; }
QLabel#status_lb { background: rgba(255,255,250,235); padding: 7px; border-radius: 6px; }
QTabWidget::pane { border: none; }
QTabBar::tab { padding: 9px 15px; background: #e0ece2; }
QTabBar::tab:selected { background: white; color: #185c4b; }
QScrollArea { border: none; background: transparent; }
QVideoWidget { background: #101714; }
</string>
